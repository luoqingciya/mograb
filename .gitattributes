# 统一行尾。仓库里一律 LF，检出时也保持 LF，
# 避免 Windows 上 core.autocrlf 把文件改成 CRLF 之后提交上去。
* text=auto eol=lf

# Windows 批处理和 PowerShell 脚本需要 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.pyd binary
*.woff binary
*.woff2 binary
*.ttf binary

# 归档文件在 diff 里不显示内容
*.zip -diff
*.gz -diff

# 锁文件在 GitHub 上折叠显示
uv.lock linguist-generated=true
package-lock.json linguist-generated=true
