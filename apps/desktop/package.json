{
  "name": "mograb-desktop",
  "version": "0.0.0",
  "description": "MoGrab Desktop (Tauri v2) — Windows & Linux",
  "author": "MoGrab Contributors <luoqingciya@users.noreply.github.com>",
  "homepage": "https://github.com/luoqingciya/mograb",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "prebuild": "node scripts/copy-static.mjs",
    "build": "tsc -p tsconfig.renderer.json",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit",
    "dev": "tauri dev",
    "tauri": "tauri",
    "pack": "tauri build --bundles nsis",
    "pack:linux": "tauri build --bundles deb,rpm",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.7.2"
  }
}
